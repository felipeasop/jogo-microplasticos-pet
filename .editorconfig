root = true

[*.cs]
# "src" não entra no namespace: src/Jogo vira CacaAosResiduos.Jogo.
dotnet_diagnostic.IDE0130.severity = none

dotnet_naming_rule.tipos_pascal_case.severity = suggestion
dotnet_naming_rule.tipos_pascal_case.symbols = tipos
dotnet_naming_rule.tipos_pascal_case.style = pascal_case

dotnet_naming_rule.interfaces_prefixo_i.severity = suggestion
dotnet_naming_rule.interfaces_prefixo_i.symbols = interfaces
dotnet_naming_rule.interfaces_prefixo_i.style = pascal_i_pascal_case

dotnet_naming_rule.metodos_pascal_case.severity = suggestion
dotnet_naming_rule.metodos_pascal_case.symbols = metodos
dotnet_naming_rule.metodos_pascal_case.style = pascal_case

dotnet_naming_rule.propriedades_pascal_case.severity = suggestion
dotnet_naming_rule.propriedades_pascal_case.symbols = propriedades
dotnet_naming_rule.propriedades_pascal_case.style = pascal_case

dotnet_naming_rule.campos_estaticos_sublinhado_s.severity = suggestion
dotnet_naming_rule.campos_estaticos_sublinhado_s.symbols = campos_estaticos
dotnet_naming_rule.campos_estaticos_sublinhado_s.style = camel_com_sublinhado_s

dotnet_naming_rule.campos_privados_camel_com_sublinhado.severity = suggestion
dotnet_naming_rule.campos_privados_camel_com_sublinhado.symbols = campos_privados
dotnet_naming_rule.campos_privados_camel_com_sublinhado.style = camel_com_sublinhado

dotnet_naming_rule.constantes_pascal_case.severity = suggestion
dotnet_naming_rule.constantes_pascal_case.symbols = constantes
dotnet_naming_rule.constantes_pascal_case.style = pascal_case

dotnet_naming_rule.parametros_camel_case.severity = suggestion
dotnet_naming_rule.parametros_camel_case.symbols = parametros
dotnet_naming_rule.parametros_camel_case.style = camel_case

dotnet_naming_rule.variaveis_locais_camel_case.severity = suggestion
dotnet_naming_rule.variaveis_locais_camel_case.symbols = variaveis_locais
dotnet_naming_rule.variaveis_locais_camel_case.style = camel_case

dotnet_naming_symbols.tipos.applicable_kinds = class, struct, interface, enum, delegate
dotnet_naming_symbols.tipos.applicable_accessibilities = public, internal, private, protected
dotnet_naming_symbols.tipos.required_modifiers =

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = public, internal, private, protected
dotnet_naming_symbols.interfaces.required_modifiers =

dotnet_naming_symbols.metodos.applicable_kinds = method
dotnet_naming_symbols.metodos.applicable_accessibilities = public, internal, private, protected
dotnet_naming_symbols.metodos.required_modifiers =

dotnet_naming_symbols.propriedades.applicable_kinds = property
dotnet_naming_symbols.propriedades.applicable_accessibilities = public, internal, private, protected
dotnet_naming_symbols.propriedades.required_modifiers =

dotnet_naming_symbols.campos_privados.applicable_kinds = field
dotnet_naming_symbols.campos_privados.applicable_accessibilities = private
dotnet_naming_symbols.campos_privados.required_modifiers =

dotnet_naming_symbols.campos_estaticos.applicable_kinds = field
dotnet_naming_symbols.campos_estaticos.applicable_accessibilities = private, internal
dotnet_naming_symbols.campos_estaticos.required_modifiers = static

dotnet_naming_symbols.constantes.applicable_kinds = field
dotnet_naming_symbols.constantes.applicable_accessibilities = public, internal, private, protected
dotnet_naming_symbols.constantes.required_modifiers = const

dotnet_naming_symbols.parametros.applicable_kinds = parameter
dotnet_naming_symbols.parametros.applicable_accessibilities = *
dotnet_naming_symbols.parametros.required_modifiers =

dotnet_naming_symbols.variaveis_locais.applicable_kinds = local
dotnet_naming_symbols.variaveis_locais.applicable_accessibilities = *
dotnet_naming_symbols.variaveis_locais.required_modifiers =

dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_style.pascal_i_pascal_case.required_prefix = I
dotnet_naming_style.pascal_i_pascal_case.capitalization = pascal_case

dotnet_naming_style.camel_com_sublinhado.required_prefix = _
dotnet_naming_style.camel_com_sublinhado.capitalization = camel_case

dotnet_naming_style.camel_com_sublinhado_s.required_prefix = s_
dotnet_naming_style.camel_com_sublinhado_s.capitalization = camel_case

dotnet_naming_style.camel_case.capitalization = camel_case

indent_style = space
indent_size = 4
tab_width = 4

csharp_new_line_before_open_brace = all
csharp_preserve_single_line_blocks = true
csharp_preserve_single_line_statements = true
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion
dotnet_style_readonly_field = true:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members: true:suggestion
dotnet_style_namespace_match_folder = true:suggestion
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
