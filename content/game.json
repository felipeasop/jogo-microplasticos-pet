  "messages": {
    "GARRAFA PLÁSTICA": "GARRAFAS DESCARTADAS PODEM SE QUEBRAR EM PEDAÇOS CADA VEZ MENORES. REDUZIR O USO E DESCARTAR CORRETAMENTE AJUDA A EVITAR ESSE CAMINHO.",
    "SACO DE LIXO": "SACOS ABANDONADOS PODEM SER LEVADOS PELA CHUVA E PELO VENTO ATÉ A ÁGUA. MANTER O LIXO CONTIDO EVITA QUE ELE SE ESPALHE.",
    "SACOLA PLÁSTICA": "SACOLAS SOLTAS PODEM CHEGAR A RIACHOS E PRAIAS. REUTILIZAR UMA BOLSA E DESCARTAR A SACOLA CORRETAMENTE REDUZ ESSE RISCO.",
    "PAPEL": "PAPEL TAMBÉM É RESÍDUO FORA DO LUGAR. RECOLHER E SEPARAR O MATERIAL AJUDA A CUIDAR DO AMBIENTE.",
    "CANUDO": "CANUDOS PLÁSTICOS PODEM SER CARREGADOS PARA A ÁGUA E SE FRAGMENTAR. EVITAR OS DESCARTÁVEIS QUANDO POSSÍVEL DIMINUI ESSA FONTE.",
    "TAMPINHA": "TAMPINHAS PODEM SER LEVADAS PELA ÁGUA E VIRAR FRAGMENTOS MENORES COM O TEMPO. ELAS DEVEM IR PARA O DESCARTE ADEQUADO.",
    "BITUCA DE CIGARRO": "MUITAS BITUCAS TÊM FILTROS COM FIBRAS PLÁSTICAS. NO CHÃO, A CHUVA E O SOL SOLTAM ESSAS FIBRAS, QUE PODEM CHEGAR À ÁGUA.",
    "ÓCULOS": "ARMAÇÕES E LENTES PODEM CONTER PLÁSTICO. OBJETOS ESQUECIDOS NO CHÃO PODEM SE FRAGMENTAR COM O TEMPO.",
    "CELULAR": "ELETRÔNICOS CONTÊM MATERIAIS QUE PEDEM COLETA ESPECIAL. NÃO DEVEM SER DEIXADOS NO SOLO OU NA ÁGUA.",
    "FÓSFORO": "PEQUENOS RESÍDUOS TAMBÉM PODEM SER LEVADOS PELA ÁGUA. O DESCARTE CORRETO EVITA QUE SE ACUMULEM NO AMBIENTE.",
    "PENDRIVE": "PENDRIVES TÊM PLÁSTICO E COMPONENTES ELETRÔNICOS. DEVEM IR PARA A COLETA DE ELETRÔNICOS.",
    "MICROPLÁSTICOS": "MICROPLÁSTICOS SÃO PARTÍCULAS PEQUENAS DE PLÁSTICO. PODEM SE ESPALHAR PELA ÁGUA E AFETAR SERES VIVOS. AQUI SÃO MOSTRADOS POR UMA LENTE EDUCATIVA."
  },
